#!/usr/bin/env bash
# scripts/release — chain check → build → deploy.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"
# shellcheck source=../ci-toolkit
source ./ci-toolkit

# @description Run the end-to-end release pipeline
run_pipeline() {
    ci::info "=== release pipeline start ==="
    
    ./scripts/check
    ./scripts/build
    ./scripts/deploy
    
    ci::info "=== release pipeline done ==="
}

main() {
    run_pipeline
}

main "$@"
