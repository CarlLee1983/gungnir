#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

rc::toolkit_version() {
  local target_file="$1"

  grep -E '^CI_TOOLKIT_VERSION=' "$target_file" \
    | head -1 \
    | sed -E 's/^CI_TOOLKIT_VERSION="([^"]*)".*/\1/' \
    || true
}

rc::version() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"
  local changelog_file="${2:-$ROOT_DIR/CHANGELOG.md}"

  local constant
  constant="$(rc::toolkit_version "$target_file")"

  local latest
  latest="$(grep -E '^## v' "$changelog_file" \
    | head -1 \
    | sed -E 's/^## v([^ ]+).*/\1/' \
    || true)"

  if [[ -z "$constant" || -z "$latest" ]]; then
    printf 'version: could not parse versions (constant=%s, changelog=%s)\n' \
      "$constant" "$latest" >&2
    return 1
  fi

  if [[ "$constant" != "$latest" ]]; then
    printf 'version: CI_TOOLKIT_VERSION=%s does not match CHANGELOG v%s\n' \
      "$constant" "$latest" >&2
    return 1
  fi

  printf 'version: ok (%s)\n' "$constant"
}

rc::artifact() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"
  local readme_file="${2:-$ROOT_DIR/README.md}"

  if [[ ! -x "$target_file" ]]; then
    printf 'artifact: %s is not executable\n' "$target_file" >&2
    return 1
  fi

  if ! head -1 "$target_file" | grep -Eq '^#!/usr/bin/env bash$|^#!/.*bash$'; then
    printf 'artifact: %s must use a Bash shebang\n' "$target_file" >&2
    return 1
  fi

  if ! grep -q 'Bash 4+' "$target_file"; then
    printf 'artifact: %s is missing the Bash 4+ marker\n' "$target_file" >&2
    return 1
  fi

  local constant
  constant="$(rc::toolkit_version "$target_file")"
  if [[ -z "$constant" ]]; then
    printf 'artifact: could not parse CI_TOOLKIT_VERSION from %s\n' "$target_file" >&2
    return 1
  fi

  local readme_version
  readme_version="$(grep -Eo 'releases/download/v[0-9][^/[:space:]]*/ci-toolkit' \
    "$readme_file" \
    | head -1 \
    | sed -E 's#releases/download/v([^/]+)/ci-toolkit#\1#' \
    || true)"
  if [[ -z "$readme_version" ]]; then
    printf 'artifact: could not parse README install URL from %s\n' "$readme_file" >&2
    return 1
  fi

  if [[ "$constant" != "$readme_version" ]]; then
    printf 'artifact: README install URL v%s does not match CI_TOOLKIT_VERSION=%s\n' \
      "$readme_version" "$constant" >&2
    return 1
  fi

  printf 'artifact: ok\n'
}

rc::boundary() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"

  local vendor_hits
  vendor_hits="$(grep -nE 'GITHUB_|GITLAB_|CIRCLE_|BUILDKITE_|BITBUCKET_' \
    "$target_file" || true)"
  if [[ -n "$vendor_hits" ]]; then
    printf '%s\n' "$vendor_hits" >&2
    printf 'boundary: CI-vendor markers found in %s\n' "$target_file" >&2
    return 1
  fi

  local forbidden
  forbidden="$(grep -nE '^[[:space:]]*(build|deploy|release|test|lint)\)' \
    "$target_file" || true)"
  if [[ -n "$forbidden" ]]; then
    printf '%s\n' "$forbidden" >&2
    printf 'boundary: forbidden public command names found in dispatch of %s\n' \
      "$target_file" >&2
    return 1
  fi

  printf 'boundary: ok\n'
}

rc::descriptions() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"

  if [[ ! -x "$target_file" ]]; then
    printf 'descriptions: %s is not executable\n' "$target_file" >&2
    return 1
  fi

  local missing
  missing="$("$target_file" ls 2>/dev/null | grep -F '(No description)' || true)"
  if [[ -n "$missing" ]]; then
    printf '%s\n' "$missing" >&2
    printf 'descriptions: public ci:: functions missing # @description in %s\n' \
      "$target_file" >&2
    return 1
  fi

  printf 'descriptions: ok\n'
}

rc::copy_smoke() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"
  local tmpdir=""
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "${tmpdir:-}"' RETURN

  cp "$target_file" "$tmpdir/ci-toolkit"
  chmod +x "$tmpdir/ci-toolkit"

  local rc=0
  (
    cd "$tmpdir"
    ./ci-toolkit help >/dev/null
    ./ci-toolkit version | grep -q '^ci-toolkit '
    bash -c "source './ci-toolkit' && ci::info 'ok'" >/dev/null 2>/dev/null
  ) || rc=$?

  if [[ "$rc" -ne 0 ]]; then
    printf 'copy-smoke: standalone artifact failed (rc=%s)\n' "$rc" >&2
    return 1
  fi

  printf 'copy-smoke: ok\n'
}

rc::gates() {
  # Guard against infinite recursion: scripts/test runs tests/test_release_check.sh,
  # which calls "release-check all", which calls rc::gates, which calls scripts/test
  # again. When RC_INSIDE_GATES is already set we are in a recursive invocation;
  # skip scripts/test to break the cycle while still running lint and smoke.
  local tests_status="ok"
  if [[ -z "${RC_INSIDE_GATES:-}" ]]; then
    RC_INSIDE_GATES=1 "$ROOT_DIR/scripts/test"
  else
    tests_status="skipped (recursive invocation)"
  fi

  local lint_status
  "$ROOT_DIR/scripts/lint"
  if command -v shellcheck >/dev/null 2>&1; then
    lint_status="ran"
  else
    lint_status="skipped (shellcheck not installed)"
  fi

  "$ROOT_DIR/scripts/smoke"

  local docs_status
  if command -v bun >/dev/null 2>&1; then
    bun run "$ROOT_DIR/scripts/check-user-docs.ts"
    docs_status="ran"
  else
    docs_status="skipped (bun not installed)"
  fi

  printf 'gates: tests %s; lint %s; smoke ok; docs %s\n' \
    "$tests_status" "$lint_status" "$docs_status"
}

rc::examples() {
  local target_file="${1:-$ROOT_DIR/ci-toolkit}"
  local examples_dir="${2:-$ROOT_DIR/examples}"

  local constant
  constant="$(rc::toolkit_version "$target_file")"
  if [[ -z "$constant" ]]; then
    printf 'examples: could not parse CI_TOOLKIT_VERSION from %s\n' \
      "$target_file" >&2
    return 1
  fi

  if [[ ! -d "$examples_dir" ]]; then
    printf 'examples: ok (no examples dir at %s)\n' "$examples_dir"
    return 0
  fi

  local mismatches=""
  while IFS= read -r -d '' file; do
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      mismatches+="$file: $line"$'\n'
    done < <(grep -nE 'releases/download/v[0-9][^/[:space:]]*/ci-toolkit|Vendor Gungnir ci-toolkit v[0-9][^[:space:]"]*' "$file" 2>/dev/null \
      | grep -Ev "v${constant}([/[:space:]\"]|$)" || true)
  done < <(find "$examples_dir" -type f \( -name '*.md' -o -name '*.sh' \) -print0)

  if [[ -n "$mismatches" ]]; then
    printf '%s' "$mismatches" >&2
    printf 'examples: stale version pin(s) found; expected v%s\n' \
      "$constant" >&2
    return 1
  fi

  printf 'examples: ok (v%s)\n' "$constant"
}

main() {
  local subcommand="${1:-all}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  case "$subcommand" in
    version)
      rc::version "$@"
      ;;
    artifact)
      rc::artifact "$@"
      ;;
    boundary)
      rc::boundary "$@"
      ;;
    copy-smoke)
      rc::copy_smoke "$@"
      ;;
    descriptions)
      rc::descriptions "$@"
      ;;
    examples)
      rc::examples "$@"
      ;;
    gates)
      rc::gates "$@"
      ;;
    all)
      rc::version
      rc::artifact
      rc::gates
      rc::boundary
      rc::descriptions
      rc::copy_smoke
      rc::examples
      printf 'release-check: all checks passed\n'
      ;;
    *)
      printf 'usage: release-check [version|artifact|boundary|copy-smoke|descriptions|examples|gates|all]\n' >&2
      return 64
      ;;
  esac
}

main "$@"
