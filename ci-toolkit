#!/usr/bin/env bash
# ci-toolkit: experimental platform-neutral helpers for CI Bash scripts.
# Usage as CLI:    ./ci-toolkit help
# Usage as source: source ./ci-toolkit && ci::info "message"
# Runtime: Bash 4+

CI_TOOLKIT_VERSION="0.1.4"
CI_TOOLKIT_NAME="ci-toolkit"

# Log a message with a specific level (info, warn, error, debug).
ci::log() {
  local level="$1"
  shift || true
  local message="$*"

  if [[ "$level" == "debug" ]]; then
    if ! ci::is_true CI_TOOLKIT_DEBUG; then
      return 0
    fi
  fi

  printf '[%s] %s\n' "$level" "$message" >&2
}

# Log an info level message.
ci::info() {
  ci::log info "$@"
}

# Log a warning level message.
ci::warn() {
  ci::log warn "$@"
}

# Log an error level message.
ci::error() {
  ci::log error "$@"
}

# Log a debug level message.
ci::debug() {
  ci::log debug "$@"
}

# Exit with an error message.
ci::die() {
  ci::error "$*"
  return 1
}

# Ensure an environment variable is set and not empty.
ci::require_env() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::require_env VAR_NAME"
    return 64
  fi

  if [[ -z "${!name+x}" || -z "${!name}" ]]; then
    ci::error "Missing required environment variable: $name"
    return 1
  fi

  return 0
}

# Ensure a tool is available on the PATH.
ci::require_tool() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::require_tool TOOL_NAME"
    return 64
  fi

  if ! command -v "$name" >/dev/null 2>&1; then
    ci::error "Missing required tool: $name"
    return 1
  fi

  return 0
}

# Retry a command N times, with an optional delay between attempts.
ci::retry() {
  local attempts="${1:-}"
  shift || true

  if [[ -z "$attempts" || ! "$attempts" =~ ^[0-9]+$ || "$attempts" -lt 1 ]]; then
    ci::error "Usage: ci::retry ATTEMPTS [--delay SECONDS] [--] COMMAND..."
    return 64
  fi

  local delay=0
  while (( $# > 0 )); do
    case "$1" in
      --delay)
        if [[ $# -lt 2 ]]; then
          ci::error "ci::retry: --delay requires a value"
          return 64
        fi
        if [[ ! "$2" =~ ^[0-9]+$ ]]; then
          ci::error "ci::retry: --delay value must be a non-negative integer, got: $2"
          return 64
        fi
        delay="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      --*)
        ci::error "ci::retry: unknown option: $1"
        return 64
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ "$#" -eq 0 ]]; then
    ci::error "Usage: ci::retry ATTEMPTS [--delay SECONDS] [--] COMMAND..."
    return 64
  fi

  local attempt status
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    set +e
    "$@"
    status=$?
    set -e

    if [[ "$status" -eq 0 ]]; then
      return 0
    fi

    ci::warn "Attempt $attempt/$attempts failed with status $status: $*"

    if (( attempt < attempts && delay > 0 )); then
      sleep "$delay"
    fi
  done

  return "$status"
}
 
# Set a default value for an environment variable if it is not set.
ci::env_default() {
  local name="${1:-}"
  local default="${2:-}"
 
  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::env_default VAR_NAME DEFAULT_VALUE"
    return 64
  fi
 
  if [[ -z "${!name+x}" || -z "${!name}" ]]; then
    printf -v "$name" "%s" "$default"
    ci::debug "set default: $name=$default"
  fi
}
 
# Check if an environment variable is "1" or "true".
ci::is_true() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::is_true VAR_NAME"
    return 64
  fi
  [[ "${!name:-0}" == "1" || "${!name:-}" == "true" ]]
}
 
# Find a marker file by searching up the directory tree.
ci::find_up() {
  local marker="${1:-}"
  local dir

  if [[ -z "$marker" ]]; then
    ci::error "Usage: ci::find_up MARKER"
    return 64
  fi

  dir="$(pwd)"
  while [[ "$dir" != "/" ]]; do
    if [[ -e "$dir/$marker" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  ci::error "Could not find marker: $marker"
  return 1
}

# Find the Git repository root.
ci::root() {
  ci::find_up .git
}

# Get the latest Git tag matching a prefix.
ci::git_latest_tag() {
  local prefix="${1:-}"
  local latest_tag

  ci::require_tool git || return 1

  latest_tag=$(git tag -l "${prefix}*" 2>/dev/null | sort -V | tail -n 1)
  
  if [[ -n "$latest_tag" ]]; then
    printf '%s\n' "$latest_tag"
    return 0
  else
    ci::error "no tag matches ${prefix}*"
    return 1
  fi
}

# Send a notification to a Slack webhook.
ci::slack_webhook() {
  local url_var="${1:-}"
  local project="${2:-}"
  local status="${3:-}"
  local message="${4:-}"

  if [[ -z "$url_var" || -z "$project" || -z "$status" || -z "$message" ]]; then
    ci::error "Usage: ci::slack_webhook URL_VAR PROJECT STATUS MESSAGE"
    return 64
  fi

  if [[ -z "${!url_var+x}" || -z "${!url_var}" ]]; then
    ci::warn "Slack webhook variable $url_var is not set; skipping"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    ci::warn "curl is not on PATH; skipping Slack"
    return 0
  fi

  local payload="{\"text\": \"*[$project]* ${status}: ${message}\"}"

  ci::retry 3 curl -sS --connect-timeout 5 --max-time 15 \
    -X POST -H 'Content-type: application/json' \
    --data "$payload" "${!url_var}" -o /dev/null || true
}

# List all available ci:: functions and their descriptions.
ci::ls() {
  local script_file="${BASH_SOURCE[0]}"
  if [[ ! -f "$script_file" ]]; then
    ci::error "Could not locate ci-toolkit source file."
    return 1
  fi

  awk '
  /^# / {
    if (comment == "") {
      comment = substr($0, 3)
    } else {
      comment = comment " " substr($0, 3)
    }
    next
  }
  /^ci::.*\(.*\) \{/ {
    func_name = $1
    sub(/\(.*\)/, "", func_name)
    if (func_name ~ /^ci::cmd_/ || func_name == "ci::dispatch" || func_name == "ci::usage") {
        comment = ""
        next
    }
    if (comment == "") {
      comment = "(No description)"
    }
    printf "  %-20s %s\n", func_name, comment
    comment = ""
    next
  }
  {
    comment = ""
  }
  ' "$script_file" | sort
}

ci::usage() {
  cat <<'USAGE'
ci-toolkit - Experimental platform-neutral CI Bash toolkit

Usage:
  ci-toolkit help
  ci-toolkit version
  ci-toolkit log <info|warn|error|debug> <message>
  ci-toolkit env require VAR_NAME
  ci-toolkit env default VAR_NAME DEFAULT_VALUE
  ci-toolkit tool require TOOL_NAME
  ci-toolkit retry [ATTEMPTS] [--delay SECONDS] -- COMMAND [ARGS...]
  ci-toolkit git latest-tag [PREFIX]
  ci-toolkit slack webhook URL_VAR PROJECT STATUS MESSAGE
  ci-toolkit ls

Source mode:
  source ./ci-toolkit
  ci::info "message"

Experimental: CLI and source APIs may change before stabilization.
USAGE
}

ci::cmd_help() {
  ci::usage
}

ci::cmd_ls() {
  ci::ls
}

ci::cmd_version() {
  printf '%s %s\n' "$CI_TOOLKIT_NAME" "$CI_TOOLKIT_VERSION"
}

ci::cmd_log() {
  local level="${1:-}"
  shift || true

  case "$level" in
    info|warn|error|debug)
      ci::log "$level" "$@"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_env() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    require)
      ci::require_env "${1:-}"
      ;;
    default)
      local name="${1:-}"
      local default="${2:-}"
      if [[ -z "$name" ]]; then
        ci::usage >&2
        return 64
      fi
      # In CLI mode, we just print the value or default
      if [[ -z "${!name+x}" || -z "${!name}" ]]; then
        printf '%s\n' "$default"
      else
        printf '%s\n' "${!name}"
      fi
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_tool() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    require)
      ci::require_tool "${1:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_retry() {
  local attempts=3
  local -a forwarded=()

  if [[ "${1:-}" != "--" && "${1:-}" != "--delay" ]]; then
    attempts="${1:-}"
    shift || true
  fi

  if [[ -z "$attempts" || ! "$attempts" =~ ^[0-9]+$ || "$attempts" -lt 1 ]]; then
    ci::usage >&2
    return 64
  fi

  while (( $# > 0 )); do
    case "$1" in
      --delay)
        if [[ $# -lt 2 ]]; then
          ci::usage >&2
          return 64
        fi
        forwarded+=(--delay "$2")
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        ci::usage >&2
        return 64
        ;;
    esac
  done

  if [[ "$#" -eq 0 ]]; then
    ci::usage >&2
    return 64
  fi

  ci::retry "$attempts" "${forwarded[@]}" -- "$@"
}

ci::cmd_git() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    latest-tag)
      ci::git_latest_tag "${1:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_slack() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    webhook)
      ci::slack_webhook "${1:-}" "${2:-}" "${3:-}" "${4:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::dispatch() {
  local command="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  case "$command" in
    help|-h|--help)
      ci::cmd_help "$@"
      ;;
    version|--version)
      ci::cmd_version "$@"
      ;;
    log)
      ci::cmd_log "$@"
      ;;
    env)
      ci::cmd_env "$@"
      ;;
    tool)
      ci::cmd_tool "$@"
      ;;
    git)
      ci::cmd_git "$@"
      ;;
    slack)
      ci::cmd_slack "$@"
      ;;
    retry)
      ci::cmd_retry "$@"
      ;;
    ls)
      ci::cmd_ls "$@"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  ci::dispatch "$@"
  exit $?
fi
