#!/usr/bin/env bash
# ci-toolkit: experimental platform-neutral helpers for CI Bash scripts.
# Usage as CLI:    ./ci-toolkit help
# Usage as source: source ./ci-toolkit && ci::info "message"
# Runtime: Bash 4+

CI_TOOLKIT_VERSION="0.1.1"
CI_TOOLKIT_NAME="ci-toolkit"

ci::log() {
  local level="$1"
  shift || true
  local message="$*"

  if [[ "$level" == "debug" && "${CI_TOOLKIT_DEBUG:-}" != "1" ]]; then
    return 0
  fi

  printf '[%s] %s\n' "$level" "$message" >&2
}

ci::info() {
  ci::log info "$@"
}

ci::warn() {
  ci::log warn "$@"
}

ci::error() {
  ci::log error "$@"
}

ci::debug() {
  ci::log debug "$@"
}

ci::die() {
  ci::error "$*"
  return 1
}

ci::require_env() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::require_env VAR_NAME"
    return 64
  fi

  if [[ -z "${!name+x}" || -z "${!name}" ]]; then
    ci::error "Missing required environment variable: $name"
    return 1
  fi

  return 0
}

ci::require_tool() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    ci::error "Usage: ci::require_tool TOOL_NAME"
    return 64
  fi

  if ! command -v "$name" >/dev/null 2>&1; then
    ci::error "Missing required tool: $name"
    return 1
  fi

  return 0
}

ci::retry() {
  local attempts="${1:-}"
  shift || true

  if [[ -z "$attempts" || ! "$attempts" =~ ^[0-9]+$ || "$attempts" -lt 1 ]]; then
    ci::error "Usage: ci::retry ATTEMPTS COMMAND..."
    return 64
  fi

  if [[ "$#" -eq 0 ]]; then
    ci::error "Usage: ci::retry ATTEMPTS COMMAND..."
    return 64
  fi

  local attempt status
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    set +e
    "$@"
    status=$?
    set -e

    if [[ "$status" -eq 0 ]]; then
      return 0
    fi

    ci::warn "Attempt $attempt/$attempts failed with status $status: $*"
  done

  return "$status"
}

ci::find_up() {
  local marker="${1:-}"
  local dir

  if [[ -z "$marker" ]]; then
    ci::error "Usage: ci::find_up MARKER"
    return 64
  fi

  dir="$(pwd)"
  while [[ "$dir" != "/" ]]; do
    if [[ -e "$dir/$marker" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  ci::error "Could not find marker: $marker"
  return 1
}

ci::root() {
  ci::find_up .git
}

ci::git_latest_tag() {
  local prefix="${1:-}"
  local latest_tag

  ci::require_tool git || return 1

  latest_tag=$(git tag -l "${prefix}*" 2>/dev/null | sort -V | tail -n 1)
  
  if [[ -n "$latest_tag" ]]; then
    printf '%s\n' "$latest_tag"
    return 0
  else
    ci::error "no tag matches ${prefix}*"
    return 1
  fi
}

ci::slack_webhook() {
  local url_var="${1:-}"
  local project="${2:-}"
  local status="${3:-}"
  local message="${4:-}"

  if [[ -z "$url_var" || -z "$project" || -z "$status" || -z "$message" ]]; then
    ci::error "Usage: ci::slack_webhook URL_VAR PROJECT STATUS MESSAGE"
    return 64
  fi

  if [[ -z "${!url_var+x}" || -z "${!url_var}" ]]; then
    ci::warn "Slack webhook variable $url_var is not set; skipping"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    ci::warn "curl is not on PATH; skipping Slack"
    return 0
  fi

  local payload="{\"text\": \"*[$project]* ${status}: ${message}\"}"

  ci::retry 3 curl -sS --connect-timeout 5 --max-time 15 \
    -X POST -H 'Content-type: application/json' \
    --data "$payload" "${!url_var}" -o /dev/null || true
}

ci::usage() {
  cat <<'USAGE'
ci-toolkit - Experimental platform-neutral CI Bash toolkit

Usage:
  ci-toolkit help
  ci-toolkit version
  ci-toolkit log <info|warn|error|debug> <message>
  ci-toolkit env require VAR_NAME
  ci-toolkit tool require TOOL_NAME
  ci-toolkit retry [ATTEMPTS] -- COMMAND [ARGS...]
  ci-toolkit git latest-tag [PREFIX]
  ci-toolkit slack webhook URL_VAR PROJECT STATUS MESSAGE

Source mode:
  source ./ci-toolkit
  ci::info "message"

Experimental: CLI and source APIs may change before stabilization.
USAGE
}

ci::cmd_help() {
  ci::usage
}

ci::cmd_version() {
  printf '%s %s\n' "$CI_TOOLKIT_NAME" "$CI_TOOLKIT_VERSION"
}

ci::cmd_log() {
  local level="${1:-}"
  shift || true

  case "$level" in
    info|warn|error|debug)
      ci::log "$level" "$@"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_env() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    require)
      ci::require_env "${1:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_tool() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    require)
      ci::require_tool "${1:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_retry() {
  local attempts=3

  if [[ "${1:-}" != "--" ]]; then
    attempts="${1:-}"
    shift || true
  fi

  if [[ "$attempts" != "3" && "${1:-}" != "--" ]]; then
    ci::usage >&2
    return 64
  fi

  if [[ -z "$attempts" || ! "$attempts" =~ ^[0-9]+$ || "$attempts" -lt 1 ]]; then
    ci::usage >&2
    return 64
  fi

  if [[ "${1:-}" != "--" ]]; then
    ci::usage >&2
    return 64
  fi
  shift

  ci::retry "$attempts" "$@"
}

ci::cmd_git() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    latest-tag)
      ci::git_latest_tag "${1:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::cmd_slack() {
  local subcommand="${1:-}"
  shift || true

  case "$subcommand" in
    webhook)
      ci::slack_webhook "${1:-}" "${2:-}" "${3:-}" "${4:-}"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

ci::dispatch() {
  local command="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  case "$command" in
    help|-h|--help)
      ci::cmd_help "$@"
      ;;
    version|--version)
      ci::cmd_version "$@"
      ;;
    log)
      ci::cmd_log "$@"
      ;;
    env)
      ci::cmd_env "$@"
      ;;
    tool)
      ci::cmd_tool "$@"
      ;;
    git)
      ci::cmd_git "$@"
      ;;
    slack)
      ci::cmd_slack "$@"
      ;;
    retry)
      ci::cmd_retry "$@"
      ;;
    *)
      ci::usage >&2
      return 64
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  ci::dispatch "$@"
  exit $?
fi
